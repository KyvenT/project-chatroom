datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Chatroom {
  id                   String           @id @default(uuid())
  title                String
  owner                User             @relation(fields: [ownerId], references: [id])
  ownerId              String
  privacy              ChatroomPrivacy  @default(INVITE_ONLY)
  createdAt            DateTime         @default(now())
  messages             Message[]
  members              ChatroomMember[]
  invites              Invite[]
}

model Message {
  id            String         @id @default(uuid())
  content       String
  senderUser    User           @relation(fields: [senderUserId], references: [id], onDelete: SetDefault)
  senderUserId  String         @default("b532df46-e953-415c-b9c0-5489ce777e70") // user ID to represent deleted users
  chatroom      Chatroom       @relation(fields: [chatroomId], references: [id], onDelete: Cascade)
  chatroomId    String
  notifications Notification[]
  createdAt     DateTime       @default(now())
  editedAt      DateTime?
}

model User {
  id              String           @id @default(uuid())
  email           String?          @unique
  username        String           @unique
  passwordHash    String
  status          Status           @default(ONLINE)
  createdAt       DateTime         @default(now())
  isGuest         Boolean          @default(false)
  sentMessages    Message[]
  joinedChatrooms ChatroomMember[]
  ownedChatrooms  Chatroom[]
  pinnedGroups    PinGroup[]
  sentInvites     Invite[]         @relation("SentInvite")
  receivedInvites Invite[]         @relation("ReceivedInvite")
  notifications   Notification[]
}

model ChatroomMember {
  member                User          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId              String
  chatroom              Chatroom      @relation(fields: [chatroomId], references: [id], onDelete: Cascade)
  chatroomId            String
  chatroomIndex         Int           
  pinGroup              PinGroup?            @relation(fields: [pinGroupId], references: [id], onDelete: SetNull)
  pinGroupId            String?
  pinnedIndex           Int?  
  role                  ChatroomRoles @default(MEMBER)
  joinedAt              DateTime      @default(now())
  lastViewedAt          DateTime      @default(now())

  @@id([chatroomId, memberId])
  @@unique([memberId, chatroomIndex])
}

model PinGroup { 
  id                    String            @id @default(uuid())
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String
  pinnedChatrooms       ChatroomMember[]
  name                  String
  index                 Int
  createdAt             DateTime          @default(now())
}

model Invite {
  id           String        @id @default(uuid())
  sender       User          @relation("SentInvite", fields: [senderId], references: [id], onDelete: Cascade)
  senderId     String
  receiver     User          @relation("ReceivedInvite", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId   String
  chatroom     Chatroom      @relation(fields: [chatroomId], references: [id], onDelete: Cascade)
  chatroomId   String
  status       InviteStatus  @default(PENDING)
  sentAt       DateTime      @default(now())
  notification Notification?
}

model Notification {
  id        String           @id @default(uuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  type      NotificationType
  invite    Invite?          @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  inviteId  String?          @unique
  message   Message?         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String?
}

enum NotificationType {
  MENTION
  INVITE
}

enum Status {
  ONLINE
  AWAY
  OFFLINE
}

enum InviteStatus {
  ACCEPTED
  PENDING
  REJECTED
}

enum ChatroomRoles {
  OWNER
  ADMIN
  MEMBER
}

enum ChatroomPrivacy {
  INVITE_ONLY
  INVITE_PLUS
  JOINABLE
  PUBLIC
}
