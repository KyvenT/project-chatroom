datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Chatroom {
  id                   String           @id @default(uuid())
  joinKey              String           @unique // shared to join; can be regenerated by the owner
  title                String
  owner                User             @relation(fields: [ownerId], references: [id])
  ownerId              String
  privacy              ChatroomPrivacy  @default(INVITE_ONLY)
  createdAt            DateTime         @default(now())
  messages             Message[]
  members              ChatroomMember[]
  invites              Invite[]
  pinGroups            MemberPinnedGroups[] 
}

model Message {
  id            String         @id @default(uuid())
  content       String
  // null once the sender's account is deleted; the message itself stays
  senderUser    User?          @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  senderUserId  String?
  chatroom      Chatroom       @relation(fields: [chatroomId], references: [id], onDelete: Cascade)
  chatroomId    String
  notifications Notification[]
  attachment    Attachment?
  createdAt     DateTime       @default(now())
  editedAt      DateTime?
}

// a file sent as a message; its bytes are only loaded when it's downloaded
model Attachment {
  id        String   @id @default(uuid())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String   @unique
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

model User {
  id              String           @id @default(uuid())
  email           String?          @unique
  username        String           @unique
  passwordHash    String
  status          Status           @default(ONLINE)
  createdAt       DateTime         @default(now())
  isGuest         Boolean          @default(false)
  sentMessages    Message[]
  joinedChatrooms ChatroomMember[]
  ownedChatrooms  Chatroom[]
  pinnedGroups    PinGroup[]
  sidebarFolders  SidebarFolder[]
  sentInvites     Invite[]         @relation("SentInvite")
  receivedInvites Invite[]         @relation("ReceivedInvite")
  notifications   Notification[]
  sessions        Session[]
}

model ChatroomMember {
  member                User          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId              String
  chatroom              Chatroom      @relation(fields: [chatroomId], references: [id], onDelete: Cascade)
  chatroomId            String
  chatroomIndex         Int           
  role                  ChatroomRoles @default(MEMBER)
  joinedAt              DateTime      @default(now())
  lastViewedAt          DateTime      @default(now())
  // the member's own sidebar folder for this chatroom; null shows it under Chats
  folder                SidebarFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId              String?

  @@id([chatroomId, memberId])
  @@unique([memberId, chatroomIndex])
}

model SidebarFolder {
  id                    String           @id @default(uuid())
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String
  name                  String
  index                 Int
  createdAt             DateTime         @default(now())
  chatrooms             ChatroomMember[]
}

model PinGroup { 
  id                    String            @id @default(uuid())
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String
  chatrooms             MemberPinnedGroups[]
  name                  String
  index                 Int
  createdAt             DateTime         @default(now())
}

model MemberPinnedGroups {
  chatroom              Chatroom        @relation(fields: [chatroomId], references: [id], onDelete: Cascade)
  chatroomId            String
  pinGroup              PinGroup        @relation(fields: [pinGroupId], references: [id], onDelete: Cascade)
  pinGroupId            String
  pinnedIndex           Int 

  @@id([chatroomId, pinGroupId])
}

model Invite {
  id           String        @id @default(uuid())
  sender       User          @relation("SentInvite", fields: [senderId], references: [id], onDelete: Cascade)
  senderId     String
  receiver     User          @relation("ReceivedInvite", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId   String
  chatroom     Chatroom      @relation(fields: [chatroomId], references: [id], onDelete: Cascade)
  chatroomId   String
  status       InviteStatus  @default(PENDING)
  sentAt       DateTime      @default(now())
  notification Notification?
}

model Notification {
  id        String           @id @default(uuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  type      NotificationType
  invite    Invite?          @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  inviteId  String?          @unique
  message   Message?         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String?
}

model Session {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  refreshToken String   @unique
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
}

enum NotificationType {
  MENTION
  INVITE
}

enum Status {
  ONLINE
  AWAY
  OFFLINE
}

enum InviteStatus {
  ACCEPTED
  PENDING
  REJECTED
}

enum ChatroomRoles {
  OWNER
  ADMIN
  MEMBER
}

enum ChatroomPrivacy {
  INVITE_ONLY
  INVITE_PLUS
  JOINABLE
  PUBLIC
}
